# ╔══════════════════════════════════════════════════════════════════╗
# ║          POLYMARKET TRADING BOT — ENVIRONMENT VARIABLES         ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# HOW TO USE THIS FILE:
#   1. Copy this file and rename it to ".env"
#      (On Mac/Linux: cp .env.example .env)
#      (On Windows:   copy .env.example .env)
#   2. Fill in your values below
#   3. NEVER share your .env file or commit it to Git
#
# The .env file is already in .gitignore so it won't be uploaded.

# ──────────────────────────────────────────────────────────────────
# LIVE TRADING (Required to trade with real money)
# ──────────────────────────────────────────────────────────────────
# Set to "true" to allow LIVE wallets to execute real trades.
# BOTH this variable AND config.yaml must enable live trading.
# Default: false (paper trading only — no real money used)
ENABLE_LIVE_TRADING=false

# ──────────────────────────────────────────────────────────────────
# POLYMARKET V2 AUTH (Required for LIVE trading)
# ──────────────────────────────────────────────────────────────────
# Private key for the bot's EOA wallet (0x-prefixed hex string).
# Used to sign EIP-712 orders and derive API credentials automatically.
# Get this from your wallet (MetaMask → Export Private Key, etc.)
# Leave blank if you only want paper trading.
POLYMARKET_PRIVATE_KEY=

# V2: API credentials are now auto-derived from POLYMARKET_PRIVATE_KEY at startup.
# Do NOT set these manually — they will be ignored.
# POLYMARKET_API_KEY=     (derived from private key, no longer used)
# POLYMARKET_API_SECRET=  (derived)
# POLYMARKET_API_PASSPHRASE= (derived)

# ──────────────────────────────────────────────────────────────────
# POLYGON RPC ENDPOINTS
# ──────────────────────────────────────────────────────────────────

# Hot-path RPC — used by the live trading engine for all order execution.
# A pruned (non-archive) node is fine here; only recent blocks are needed.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Archive RPC — used ONLY by the reconciler for historical log lookups
# (e.g., PositionSplit events on long-held positions, collateral type detection).
# The hot trading path NEVER reads this variable.
# Provision a free Alchemy / QuickNode archive endpoint and paste the URL here.
POLYGON_ARCHIVE_RPC_URL=

# ──────────────────────────────────────────────────────────────────
# OPTIONAL SETTINGS
# ──────────────────────────────────────────────────────────────────

# Dashboard port (default: 3000)
# Change this if port 3000 is already in use on your machine.
DASHBOARD_PORT=3000

# Log level: trace | debug | info | warn | error | fatal
# Use "debug" to see more details, "info" for normal operation.
LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────
# SAAS / AUTH SETTINGS
# ──────────────────────────────────────────────────────────────────

# Secret key for signing JWT tokens (CHANGE THIS IN PRODUCTION)
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production

# Admin email — this user is auto-promoted to admin on signup
ADMIN_EMAIL=

# ──────────────────────────────────────────────────────────────────
# STRIPE BILLING (Required for paid SaaS mode)
# ──────────────────────────────────────────────────────────────────
# If these are left blank, the app runs in free/open mode (no billing).

# Your Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Your Stripe webhook signing secret (starts with whsec_)
# Set up a webhook endpoint at /api/billing/webhook in your Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# The Stripe Price ID for the monthly subscription (starts with price_)
# Create a recurring price in Stripe → Products, then paste the ID here.
STRIPE_PRICE_ID=

# One-time signup fee in cents (default: 4999 = $49.99). Set to 0 for no signup fee.
SIGNUP_FEE_CENTS=4999

# LEMON SQUEEZY BILLING (Alternative to Stripe)
# ──────────────────────────────────────────────────────────────────
# Leave blank to disable. Get keys at https://app.lemonsqueezy.com/settings/api

# Your Lemon Squeezy API key
LEMONSQUEEZY_API_KEY=

# Your store ID (found in Settings → Stores)
LEMONSQUEEZY_STORE_ID=

# The variant ID for the monthly subscription plan
LEMONSQUEEZY_VARIANT_ID=

# Webhook signing secret (set up webhook at /api/billing/lemonsqueezy/webhook)
LEMONSQUEEZY_WEBHOOK_SECRET=

# NOWPAYMENTS — CRYPTO PAYMENTS
# ──────────────────────────────────────────────────────────────────
# Leave blank to disable. Sign up at https://nowpayments.io

# Your NOWPayments API key
NOWPAYMENTS_API_KEY=

# Public Key from the NOWPayments API Keys page
NOWPAYMENTS_PUBLIC_KEY=

# Monthly price in USD for crypto payments (default: 29.99)
NOWPAYMENTS_PRICE_USD=29.99
